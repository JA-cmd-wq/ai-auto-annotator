# ai-auto-annotator backend 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env

# OpenAI 兼容 LLM（提示词优化 / 生成任务配置，必填）
# 不填则「生成任务配置」功能不可用，请填入你自己的 Key
MATPOOL_KEY=
MATPOOL_ENDPOINT=https://token.matpool.com/v1/chat/completions
MATPOOL_LLM=DeepSeek-V4-Pro

# 推理引擎：auto 在 Linux 上自动走 Python sidecar
LA_ENGINE=auto
LA_PYTHON_URL=http://127.0.0.1:8001
LA_MODEL_PATH=/mnt/LocateAnything-3B

# 后端 HTTP 端口
APP_ADDR=:8088
APP_FRONTEND_ORIGIN=http://localhost:5173
